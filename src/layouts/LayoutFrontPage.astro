---
import { sanitizeHtml } from '../utils/sanitize';
import '../styles/global.css';
import DisplaySettings from '../components/DisplaySettings.astro';
import ThemeInjector from '../components/ThemeInjector.astro';
import LayoutGlobalHeader from '../components/LayoutGlobalHeader.astro';
import LayoutGlobalFooter from '../components/LayoutGlobalFooter.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../lib/db';
import { getGeneralSettingsCached } from '../lib/queries';


interface Props {
  title: string;
  metaDescription?: string;
  schema?: string;
  headerStyle?: string;
  footerStyle?: string;
}

const { title, metaDescription, schema, headerStyle = 'default', footerStyle = 'default' } = Astro.props;

let generalConfig = {
    siteTitle: 'Waritaku',
    siteUrl: 'https://waritaku.com',
    siteDescription: 'Membahas Pop Kultur',
    tagline: '',
    faviconUrl: '/favicon.svg',
    logoUrl: '',
    language: 'id',
    headerHtml: '',
    footerHtml: ''
};

if (env && (env as any).DB) {
    try {
        const db = getDb(env as any);
        const parsed = await getGeneralSettingsCached(db);
        generalConfig = { ...generalConfig, ...parsed };
    } catch(e) {}
}

let displayTitle = generalConfig.siteTitle;
if (title && title !== 'Home' && title !== generalConfig.siteTitle) {
    displayTitle = `${title} | ${generalConfig.siteTitle}`;
} else if (generalConfig.tagline) {
    displayTitle = `${generalConfig.siteTitle} | ${generalConfig.tagline}`;
}
const displayDesc = metaDescription || generalConfig.siteDescription || generalConfig.tagline;
const ogImg = generalConfig.logoUrl
    ? (generalConfig.logoUrl.startsWith('http') ? generalConfig.logoUrl : new URL(generalConfig.logoUrl, generalConfig.siteUrl).toString())
    : '';
let cleanPath = Astro.url.pathname;
if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
    cleanPath = cleanPath.slice(0, -1);
}
const canonicalUrl = new URL(cleanPath, generalConfig.siteUrl).toString();
---

<!doctype html>
<html lang={generalConfig.language} data-spacing="normal" data-text-size="normal">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={generalConfig.faviconUrl} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{displayTitle}</title>
    {displayDesc && <meta name="description" content={displayDesc} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={generalConfig.siteTitle} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:url" content={canonicalUrl} />
    {displayDesc && <meta property="og:description" content={displayDesc.slice(0, 200)} />}
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    {displayDesc && <meta name="twitter:description" content={displayDesc.slice(0, 200)} />}
    {ogImg && <meta name="twitter:image" content={ogImg} />}
    {schema && <script type="application/ld+json" set:html={schema} />}
    {generalConfig.headerHtml && <Fragment set:html={sanitizeHtml(generalConfig.headerHtml)} />}
        
        <script is:inline>
            // Prevent FOUC (Flash of Unstyled Content) by instantly applying settings
            (function() {
                try {
                    var theme = localStorage.getItem('theme') || 'system';
                    var root = document.documentElement;
                    if (theme === 'system') {
                        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                            root.classList.add('dark');
                        } else {
                            root.classList.add('light');
                        }
                    } else {
                        root.classList.add(theme);
                    }
                    
                    var textSize = localStorage.getItem('textSize');
                    if (textSize) root.dataset.textSize = textSize;
                    
                    var spacing = localStorage.getItem('spacing');
                    if (spacing) root.dataset.spacing = spacing;
                } catch (e) {}
            })();
        </script>
        <ThemeInjector />
    </head>
	<body class="min-h-screen bg-background font-sans antialiased flex flex-col overflow-x-hidden">
		
		<LayoutGlobalHeader headerStyle={headerStyle} />

		<main class="flex-1 py-8 md:py-12 w-full relative z-0">
			<div class="container mx-auto px-4 sm:px-6 lg:px-8">
				<slot />
			</div>
		</main>

		<LayoutGlobalFooter footerStyle={footerStyle} />
		
        <DisplaySettings />

        {generalConfig.footerHtml && <Fragment set:html={sanitizeHtml(generalConfig.footerHtml)} />}
	</body>
</html>
