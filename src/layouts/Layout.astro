---
import { sanitizeHtml } from "../utils/sanitize";
import "../styles/global.css";
import DisplaySettings from "../components/DisplaySettings.astro";
import ThemeInjector from "../components/ThemeInjector.astro";
import LayoutGlobalHeader from "../components/LayoutGlobalHeader.astro";
import LayoutGlobalFooter from "../components/LayoutGlobalFooter.astro";
import { env } from 'cloudflare:workers';
import { getDb } from "../lib/db";
import { getGeneralSettingsCached } from "../lib/queries";

interface Props {
	title: string;
	metaDescription?: string;
    noindex?: boolean;
}

const { title, metaDescription, noindex } = Astro.props;

let generalConfig = {
	siteTitle: "Waritaku",
	siteUrl: "https://waritaku.com",
	siteDescription: "Membahas Pop Kultur",
	faviconUrl: "/favicon.svg",
	logoUrl: "",
	language: "id",
	headerHtml: "",
	footerHtml: "",
};

if (env && env.DB) {
	try {
		const db = getDb(env);
		const parsed = await getGeneralSettingsCached(db);
		generalConfig = {
			...generalConfig,
			...parsed,
		};
	} catch (e) {}
}

const displayTitle = title
	? `${title} | ${generalConfig.siteTitle}`
	: generalConfig.siteTitle;
const displayDesc = metaDescription || generalConfig.siteDescription;
let cleanPath = Astro.url.pathname;
if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
    cleanPath = cleanPath.slice(0, -1);
}
const canonicalUrl = new URL(cleanPath, generalConfig.siteUrl).toString();
---

<!doctype html>
<html lang={generalConfig.language} data-spacing="normal" data-text-size="normal">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={generalConfig.faviconUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{displayTitle}</title>
		{displayDesc && <meta name="description" content={displayDesc} />}
		<link rel="canonical" href={canonicalUrl} />
        {noindex && <meta name="robots" content="noindex, follow" />}
		{/* Open Graph / Twitter Card */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={generalConfig.siteTitle} />
		<meta property="og:title" content={displayTitle} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:description" content={(displayDesc || generalConfig.siteDescription).slice(0, 200)} />
		{generalConfig.logoUrl && <meta property="og:image" content={generalConfig.logoUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={displayTitle} />
		<meta name="twitter:description" content={(displayDesc || generalConfig.siteDescription).slice(0, 200)} />
		{generalConfig.logoUrl && <meta name="twitter:image" content={generalConfig.logoUrl} />}
		{
			generalConfig.headerHtml && (
				<Fragment set:html={sanitizeHtml(generalConfig.headerHtml)} />
			)
		}

		<script is:inline>
			// Prevent FOUC (Flash of Unstyled Content) by instantly applying settings
			(function () {
				try {
					var theme = localStorage.getItem("theme") || "system";
					var root = document.documentElement;
					if (theme === "system") {
						if (
							window.matchMedia("(prefers-color-scheme: dark)")
								.matches
						) {
							root.classList.add("dark");
						} else {
							root.classList.add("light");
						}
					} else {
						root.classList.add(theme);
					}

					var textSize = localStorage.getItem("textSize");
					if (textSize) root.dataset.textSize = textSize;

					var spacing = localStorage.getItem("spacing");
					if (spacing) root.dataset.spacing = spacing;
				} catch (e) {}
			})();
		</script>
		<ThemeInjector />
	</head>
	<body
		class="min-h-screen bg-background font-sans antialiased flex flex-col selection:bg-primary selection:text-primary-foreground transition-colors duration-300"
	>
		<LayoutGlobalHeader />

		<main class="flex-1">
			<slot />
		</main>

		<LayoutGlobalFooter />

		<DisplaySettings />

		{
			generalConfig.footerHtml && (
				<Fragment set:html={sanitizeHtml(generalConfig.footerHtml)} />
			)
		}
	</body>
</html>
