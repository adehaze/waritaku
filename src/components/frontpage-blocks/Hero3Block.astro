---
import { getThumbnail } from '../../lib/utils';
interface Props {
  articles: any[];
}
const { articles } = Astro.props;


const featured = articles[0];
const subFeatured = articles.slice(1, 5); // 4 articles
---

<div class="mb-12 mt-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        
        {/* LARGE MAIN COLUMN (LEFT, 2/3 WIDTH) */}
        {featured && (
            <div class="lg:col-span-2">
                <a href={featured.canonicalUrl || `/${featured.slug}`} class="group block relative w-full overflow-hidden rounded-2xl aspect-[16/9] lg:h-[450px]">
                    <img 
                        src={featured.featuredImageUrl || getThumbnail(featured.content)} 
                        alt={featured.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        fetchpriority="high"
                        decoding="async"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 w-full p-6 md:p-10">
                        <span class="inline-block bg-primary text-primary-foreground text-xs font-bold px-3 py-1 rounded shadow uppercase tracking-wider mb-3">
                            {featured.categoryName}
                        </span>
                        <h2 class="text-white text-2xl md:text-4xl lg:text-5xl font-extrabold leading-tight group-hover:text-primary transition-colors max-w-4xl drop-shadow-lg line-clamp-3">
                            {featured.title}
                        </h2>
                        <div class="mt-4 text-xs md:text-sm text-gray-300 font-medium flex items-center space-x-2">
                            <span class="font-bold text-white">{featured.authorName}</span>
                            <span>&bull;</span>
                            <time datetime={featured.publishedAt}>{new Date(featured.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
                        </div>
                    </div>
                </a>
            </div>
        )}

        {/* 2x2 MINI GRID (RIGHT, 1/3 WIDTH) */}
        {subFeatured.length > 0 && (
            <div class="lg:col-span-1 grid grid-cols-2 gap-4 lg:grid-rows-2 h-full">
                {subFeatured.map(article => (
                    <a href={article.canonicalUrl || `/${article.slug}`} class="group block relative w-full overflow-hidden rounded-xl aspect-square md:aspect-[4/3] lg:aspect-auto lg:h-[217px]">
                        <img 
                            src={article.featuredImageUrl || getThumbnail(article.content)} 
                            alt={article.title}
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                            loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 w-full p-3 md:p-4">
                            <span class="text-primary text-[10px] md:text-xs font-black uppercase tracking-wider mb-1 block">
                                {article.categoryName}
                            </span>
                            <h3 class="text-white text-xs md:text-sm font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3">
                                {article.title}
                            </h3>
                        </div>
                    </a>
                ))}
            </div>
        )}

    </div>
</div>
