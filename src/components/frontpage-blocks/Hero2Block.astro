---
import { getThumbnail } from '../../lib/utils';
interface Props {
  articles: any[];
}
const { articles } = Astro.props;


const featured = articles[0];
const subFeatured = articles.slice(1, 5); // 4 articles
---

<div class="mb-16 mt-[-96px] md:mt-[-112px]"> 
    
    {/* BIG GIANT IMAGE SPANNING FULL VIEWPORT WIDTH */}
    {featured && (
        <div class="w-screen relative left-1/2 -translate-x-1/2 h-[50vh] md:h-[70vh] bg-muted mb-8">
            <img 
                src={featured.featuredImageUrl || getThumbnail(featured.content)} 
                alt={featured.title}
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
            {/* Fade out gradient to background color */}
            <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>
            
            <div class="absolute inset-0 flex flex-col justify-end pb-28 md:pb-40">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="max-w-4xl space-y-3 md:space-y-4">
                        <a href={`/${featured.categorySlug}`} class="inline-block bg-primary text-primary-foreground text-[10px] md:text-xs font-bold px-2.5 py-1 rounded shadow uppercase tracking-wider mb-1">
                            {featured.categoryName}
                        </a>
                        <h2 class="text-foreground text-2xl md:text-4xl lg:text-5xl font-extrabold leading-tight hover:text-primary transition-colors drop-shadow-sm line-clamp-3">
                            <a href={featured.canonicalUrl || `/${featured.slug}`}>{featured.title}</a>
                        </h2>
                        <div class="mt-2 md:mt-3 text-[10px] md:text-xs text-muted-foreground font-bold flex items-center space-x-2">
                            <span class="font-extrabold text-foreground">{featured.authorName}</span>
                            <span>&bull;</span>
                            <time datetime={featured.publishedAt}>{new Date(featured.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    )}

    {/* FLOATING 4-ITEM GRID */}
    {subFeatured.length > 0 && (
        <div class="relative z-10 -mt-24 md:-mt-32">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
                {subFeatured.map(article => (
                    <a href={article.canonicalUrl || `/${article.slug}`} class="group flex flex-col bg-card border-border rounded-xl overflow-hidden hover:shadow-xl shadow-md transition-all hover:-translate-y-1.5 border">
                        <div class="relative aspect-[16/10] w-full overflow-hidden bg-muted">
                            <img 
                                src={article.featuredImageUrl || getThumbnail(article.content)} 
                                alt={article.title}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                loading="lazy"
                            />
                        </div>
                        <div class="p-2.5 md:p-3 flex flex-col flex-1">
                            <span class="text-primary text-[9px] md:text-[10px] font-black uppercase tracking-wider mb-1 block">
                                {article.categoryName}
                            </span>
                            <h3 class="text-xs md:text-sm font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3 mb-1.5">
                                {article.title}
                            </h3>
                            <div class="mt-auto flex items-center space-x-2 text-[9px] md:text-[10px] uppercase font-bold tracking-wider text-muted-foreground">
                                <span>{article.authorName}</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    )}
</div>
