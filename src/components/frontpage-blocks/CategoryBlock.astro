---
import { getThumbnail } from '../../lib/utils';
interface Props {
  title: string;
  categorySlug: string;
  articles: any[];
}
const { title, categorySlug: rawCategorySlug, articles = [] } = Astro.props;
const categorySlug = (rawCategorySlug || '').replace(/^\/+/, '');

const featured = articles[0];
const listArticles = articles.slice(1);
---

<section class="mb-12">
    <div class="flex items-center justify-between border-b-2 border-border pb-2 mb-6">
        <h2 class="text-2xl font-extrabold uppercase tracking-tight border-l-4 border-primary pl-3 text-foreground">
            <a href={`/${categorySlug}`} class="hover:text-primary transition-colors">{title}</a>
        </h2>
        <a href={`/${categorySlug}`} class="text-xs font-bold text-muted-foreground hover:text-primary transition-colors hidden sm:flex items-center gap-1">
            Lihat Semua &raquo;
        </a>
    </div>

    {featured && (
        <a href={featured.canonicalUrl || `/${featured.slug}`} class="group block relative overflow-hidden rounded-xl aspect-[16/9] mb-4">
            <img 
                src={featured.featuredImageUrl || getThumbnail(featured.content)} 
                alt={featured.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full p-4 md:p-6">
                <span class="inline-block bg-primary text-primary-foreground text-[10px] font-black px-2 py-1 rounded-sm uppercase tracking-wider mb-2">
                    {featured.categoryName}
                </span>
                <h3 class="text-white text-xl md:text-2xl font-bold leading-snug group-hover:text-primary transition-colors line-clamp-2">
                    {featured.title}
                </h3>
                <div class="mt-2 text-xs text-gray-300 flex items-center space-x-2">
                    <span class="font-semibold text-white">{featured.authorName}</span>
                    <span>&bull;</span>
                    <time datetime={featured.publishedAt}>{new Date(featured.publishedAt).toLocaleDateString()}</time>
                </div>
            </div>
        </a>
    )}

    <div class="flex flex-col gap-4 mb-4">
        {listArticles.map(article => (
            <div class="flex flex-row gap-4 group">
                <a href={article.canonicalUrl || `/${article.slug}`} class="block relative w-32 h-20 md:w-40 md:h-24 rounded-lg overflow-hidden flex-shrink-0">
                    <img src={article.featuredImageUrl || getThumbnail(article.content)} alt={article.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </a>
                <div class="flex-1 flex flex-col justify-center">
                    <div class="flex items-center space-x-2 text-[10px] uppercase font-bold tracking-wider mb-1">
                        <a href={`/${(article.categorySlug || categorySlug).replace(/^\/+/, '')}`} class="text-primary hover:underline">{article.categoryName}</a>
                        <span class="text-muted-foreground">&bull; {article.authorName}</span>
                    </div>
                    <h4 class="text-sm md:text-base font-bold leading-snug group-hover:text-primary transition-colors line-clamp-2">
                        <a href={article.canonicalUrl || `/${article.slug}`}>{article.title}</a>
                    </h4>
                    <p class="hidden md:block text-xs text-muted-foreground mt-1 line-clamp-1">{article.excerpt}</p>
                </div>
            </div>
        ))}
    </div>

    <a href={`/${categorySlug}`} class="block w-full text-center text-sm font-bold text-muted-foreground hover:text-primary transition-colors bg-muted/30 py-2 rounded-lg">
        Lihat Semua {title} &raquo;
    </a>
</section>
