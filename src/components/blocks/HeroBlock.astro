---
export interface Props {
    block: any;
    data: any;
    headerImage: string;
}
const { block, data, headerImage } = Astro.props;
---
<div class="w-full h-[45vh] md:h-[65vh] relative overflow-hidden bg-muted mb-12">
    <img 
        src={headerImage} 
        alt={data.title || data.name}
        class="w-full h-full object-cover"
        fetchpriority="high"
        decoding="async"
        onerror="this.src='https://placehold.co/1920x1080/333/FFF?text=Waritaku'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-12">
            <div class="max-w-4xl space-y-4">
                {data.categories && data.categories.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                        {data.categories.map((cat: any) => (
                            <a href={`/${cat.slug}`} class="inline-flex items-center px-3 py-1 rounded-full bg-primary/20 text-primary text-sm font-semibold tracking-wide uppercase backdrop-blur-sm hover:bg-primary hover:text-primary-foreground transition-colors">
                                {cat.name}
                            </a>
                        ))}
                    </div>
                )}
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-tight drop-shadow-sm">
                    {data.title || data.name}
                </h1>
                <div class="flex flex-wrap items-center text-muted-foreground pt-4 font-medium gap-y-2">
                    <span>By <a href={`/author/${data.authorSlug}`} class="hover:text-primary transition-colors">{data.authorName}</a></span>
                    <span class="mx-3">•</span>
                    <span>Published: <time datetime={data.publishedAt}>{new Date(data.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></span>
                    {data.updatedAt && new Date(data.updatedAt).getTime() > new Date(data.publishedAt).getTime() + 86400000 && (
                        <>
                            <span class="mx-3 hidden sm:inline">•</span>
                            <span class="w-full sm:w-auto">Updated: <time datetime={data.updatedAt}>{new Date(data.updatedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></span>
                        </>
                    )}
                </div>
            </div>
        </div>
    </div>
</div>
