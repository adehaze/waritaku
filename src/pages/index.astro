---

function safeJsonParse(str: string, fallback: any) { try { return JSON.parse(str); } catch(e) { return fallback; } }
import LayoutFrontPage from '../layouts/LayoutFrontPage.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { entries, collections, users, taxonomies, terms, entryTerms, settings } from '../db/schema';
import {  desc, eq, and, sql, inArray, exists, or , ne } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../lib/db';
import { getCanonicalUrl, getCanonicalUrls } from '../lib/queries';

let layoutBlocks: any[] = [];
let blockData: Record<string, any> = {};

let showLeftSidebar = false;
let showRightSidebar = true;
let headerStyle = 'default';
let footerStyle = 'default';
let metaTitle = 'Waritaku CMS';
let metaDescription = 'Default Homepage';

if (env && (env as any).DB) {
    const db = getDb(env as any);
    
    // 1. Find the Homepage ID
    const settingRes = await db.select().from(settings).where(eq(settings.key, 'homepage_page_id')).limit(1);
    let homepageId = settingRes.length > 0 ? parseInt(settingRes[0].value, 10) : null;
    
    // 2. Fetch the Page
    if (homepageId && !isNaN(homepageId)) {
        const pageRes = await db.select().from(entries).where(eq(entries.id, homepageId)).limit(1);
        if (pageRes) {
            if (pageRes.length > 0) {
                const page = pageRes[0];
                const data = JSON.parse(page.data || '{}');
                metaTitle = data.metaTitle || data.title;
                metaDescription = data.metaDescription || '';
                headerStyle = data.headerStyle || 'default';
                footerStyle = data.footerStyle || 'default';
                
                let isBlockBuilderPage = false;
          let layoutBlocksData = null;
          
          if (pageRes[0].collectionId) {
             const colRes = await db.select({ fields: collections.fields }).from(collections).where(eq(collections.id, pageRes[0].collectionId)).limit(1);
             if (colRes.length > 0) {
                 const fields = JSON.parse(colRes[0].fields || '[]');
                 const blockField = fields.find((f: any) => f.type === 'blockbuilder');
                 if (blockField) {
                     isBlockBuilderPage = true;
                     const key = blockField.name || blockField.slug;
                     layoutBlocksData = data[key];
                 }
             }
          }
          // Fallback to legacy
          if (!isBlockBuilderPage && data.is_block_builder) {
              isBlockBuilderPage = true;
              layoutBlocksData = data.layout_blocks || data.layoutBlocks;
          }

          if (isBlockBuilderPage && layoutBlocksData) {
              try {
                  layoutBlocks = Array.isArray(layoutBlocksData) ? layoutBlocksData : JSON.parse(layoutBlocksData);
              } catch(e) {
                        console.error("Failed to parse layoutBlocks", e);
                    }
                }
                
                // Sidebar Config
                if (data.layout_config) {
                    try {
                        const lconf = typeof data.layout_config === 'string' ? JSON.parse(data.layout_config) : data.layout_config;
                        if (lconf.override) {
                            showLeftSidebar = lconf.showLeft;
                            showRightSidebar = lconf.showRight;
                        }
                    } catch(e) {}
                } else {
                    // Fetch Global Sidebar Config if no page override
                    const sidebarConfigRes = await db.select().from(settings).where(eq(settings.key, 'sidebar_layout_config')).limit(1);
                    if (sidebarConfigRes.length > 0) {
                        try {
                            const layoutConfig = JSON.parse(sidebarConfigRes[0].value);
                            showLeftSidebar = layoutConfig.left?.showOnFrontpage ?? false;
                            showRightSidebar = layoutConfig.right?.showOnFrontpage ?? true;
                        } catch(e) {}
                    }
                }
            }
        }
    }

    const _allCols = await db.select({ id: collections.id, fields: collections.fields }).from(collections);
    const contentColsResult = _allCols.filter((c: any) => {
        const fields = safeJsonParse(c.fields || '[]', []);
        return !fields.some((f: any) => f.slug === 'isBlockBuilder' || f.slug === 'is_block_builder');
    });
    const contentColIds = contentColsResult.map(c => c.id);

    const fetchArticles = async (options: { 
        categoryId?: string | number, 
        filterTaxonomyId?: string | number,
        filterTermId?: string | number,
        limit?: number, 
        offset?: number, 
        tagSlug?: string 
    } = {}) => {
        const { categoryId, filterTaxonomyId, filterTermId, limit = 5, offset = 0, tagSlug } = options;
        if (contentColIds.length === 0) return [];

        const hasLegacyFilter = (categoryId && categoryId !== 'all') || tagSlug;
        const hasTaxonomyFilter = filterTaxonomyId && filterTaxonomyId !== 'all';
        const hasTermFilter = filterTermId && filterTermId !== 'all';
        const hasActiveFilter = hasTermFilter || hasTaxonomyFilter || hasLegacyFilter;

        let entryIds: number[] = [];

        if (hasActiveFilter) {
            // Step 1: Resolve which term IDs to filter by — no JOIN, pure PK lookups
            let targetTermIds: number[] = [];
            if (hasTermFilter) {
                targetTermIds = [parseInt(filterTermId as string)];
            } else if (hasTaxonomyFilter) {
                const taxTerms = await db.select({ id: terms.id })
                    .from(terms)
                    .where(eq(terms.taxonomyId, parseInt(filterTaxonomyId as string)));
                targetTermIds = taxTerms.map((t: any) => t.id);
            } else if (categoryId && categoryId !== 'all') {
                targetTermIds = [parseInt(categoryId as string)];
            } else if (tagSlug) {
                const tagRow = await db.select({ id: terms.id }).from(terms).where(eq(terms.slug, tagSlug)).limit(1);
                targetTermIds = tagRow.map((t: any) => t.id);
            }
            if (targetTermIds.length === 0) return [];

            // Step 2: Fetch matching entry IDs via entry_terms PK index — zero JOIN, zero scan
            const etRows = await db.select({ entryId: entryTerms.entryId })
                .from(entryTerms)
                .where(inArray(entryTerms.termId, targetTermIds));
            const candidateIds = Array.from(new Set(etRows.map((r: any) => r.entryId)));
            if (candidateIds.length === 0) return [];

            // Sort descending (highest ID = newest) before chunking
            candidateIds.sort((a: number, b: number) => b - a);

            // Step 3: Verify by PK only — pure id IN (chunk), forces SQLite to use PK index.
            const D1_CHUNK = 50;
            let confirmed: { id: number, collectionId: number, status: string }[] = [];
            const contentColIdSet = new Set(contentColIds);
            
            for (let i = 0; i < candidateIds.length; i += D1_CHUNK) {
                const chunk = candidateIds.slice(i, i + D1_CHUNK);
                const rows = await db.select({ id: entries.id, collectionId: entries.collectionId, status: entries.status })
                    .from(entries)
                    .where(inArray(entries.id, chunk));
                    
                const valid = rows.filter((r: any) => r.status === 'published' && contentColIdSet.has(r.collectionId));
                confirmed = confirmed.concat(valid);
                
                if (confirmed.length >= offset + limit) {
                    break; // Stop fetching chunks once we have enough to fulfill offset+limit!
                }
            }
            
            confirmed.sort((a: any, b: any) => b.id - a.id);
            entryIds = confirmed.slice(offset, offset + limit).map((r: any) => r.id);

        } else {
            // No filter — composite index: status + collection_id + id
            const idRows = await db.select({ id: entries.id })
                .from(entries)
                .where(and(eq(entries.status, 'published'), inArray(entries.collectionId, contentColIds)))
                .orderBy(desc(entries.id))
                .limit(limit)
                .offset(offset);
            entryIds = idRows.map((r: any) => r.id);
        }

        if (entryIds.length === 0) return [];

        // Step 4: Fetch full entry + author rows by PK — no scan
        const D1_CHUNK = 50;
        let fullRows: any[] = [];
        for (let i = 0; i < entryIds.length; i += D1_CHUNK) {
            const chunk = entryIds.slice(i, i + D1_CHUNK);
            const rows = await db.select({ entry: entries, author: users })
                .from(entries)
                .leftJoin(users, eq(entries.authorId, users.id))
                .where(inArray(entries.id, chunk));
            fullRows = fullRows.concat(rows);
        }
        const entryMap = new Map(fullRows.map((r: any) => [r.entry.id, r]));
        const result = entryIds.map(id => entryMap.get(id)).filter(Boolean);

        // Step 5: Canonical URLs (already optimized)
        const canonicalMap = await getCanonicalUrls(db, entryIds);

        // Step 6: Category display names — separate PK queries, no JOIN+IN
        let filterCategoryName = '';
        let filterCategorySlug = '';
        const categoryMap: Record<number, { id: number, name: string, slug: string }[]> = {};

        if (hasTermFilter) {
            const row = await db.select({ name: terms.name, slug: terms.slug }).from(terms).where(eq(terms.id, parseInt(filterTermId as string))).limit(1);
            if (row.length > 0) { filterCategoryName = row[0].name; filterCategorySlug = row[0].slug; }
        } else if (categoryId && categoryId !== 'all') {
            const row = await db.select({ name: terms.name, slug: terms.slug }).from(terms).where(eq(terms.id, parseInt(categoryId as string))).limit(1);
            if (row.length > 0) { filterCategoryName = row[0].name; filterCategorySlug = row[0].slug; }
        } else if (tagSlug) {
            filterCategoryName = tagSlug;
            filterCategorySlug = `tag/${tagSlug}`;
        } else if (!hasActiveFilter && entryIds.length > 0) {
            // Batch fetch: entry_terms → terms → taxonomies, all PK — no JOIN+IN
            const etRows2 = await db.select().from(entryTerms).where(inArray(entryTerms.entryId, entryIds));
            const tIds = Array.from(new Set(etRows2.map((r: any) => r.termId)));
            if (tIds.length > 0) {
                const tRows = await db.select({ id: terms.id, name: terms.name, slug: terms.slug, taxonomyId: terms.taxonomyId })
                    .from(terms).where(inArray(terms.id, tIds));
                const taxIds = Array.from(new Set(tRows.map((t: any) => t.taxonomyId)));
                const taxRows = taxIds.length > 0
                    ? await db.select({ id: taxonomies.id, slug: taxonomies.slug }).from(taxonomies).where(inArray(taxonomies.id, taxIds))
                    : [];
                const catTaxIds = new Set(taxRows.filter((t: any) => t.slug === 'categories').map((t: any) => t.id));
                const termMap = new Map(tRows.filter((t: any) => catTaxIds.has(t.taxonomyId)).map((t: any) => [t.id, t]));
                for (const r of etRows2) {
                    const t = termMap.get((r as any).termId);
                    if (!t) continue;
                    const eid = (r as any).entryId;
                    if (!categoryMap[eid]) categoryMap[eid] = [];
                    categoryMap[eid].push({ id: (t as any).id, name: (t as any).name, slug: (t as any).slug });
                }
            }
        }

        return result.map((r: any) => {
            const data = JSON.parse(r.entry.data || '{}');
            const rawContent = data.content || '';
            const textOnly = rawContent.replace(/<[^>]+>/g, '').replace(/\[caption[^\]]*\]|\/caption\]/g, '').trim();
            const excerpt = textOnly.length > 120 ? textOnly.substring(0, 120) + '...' : textOnly;
            const prefixSlug = canonicalMap[r.entry.id];
            const canonicalUrl = prefixSlug ? `${prefixSlug}/${r.entry.slug}` : r.entry.slug;
            let cats = hasActiveFilter
                ? [{ name: filterCategoryName, slug: filterCategorySlug }]
                : (categoryMap[r.entry.id] || []);
            const primaryTermId = data.primaryTermId;
            if (primaryTermId && !hasActiveFilter) {
                cats = [...cats].sort((a: any, b: any) => {
                    if (a.id === primaryTermId) return -1;
                    if (b.id === primaryTermId) return 1;
                    return 0;
                });
            }
            return {
                id: r.entry.id,
                slug: r.entry.slug,
                canonicalUrl: `/${canonicalUrl}`,
                publishedAt: r.entry.publishedAt,
                ...data,
                categories: cats,
                categoryName: hasActiveFilter ? filterCategoryName : (cats.length > 0 ? cats[0].name : 'Article'),
                categorySlug: hasActiveFilter ? filterCategorySlug : (cats.length > 0 ? cats[0].slug : 'all'),
                authorName: r.author?.name || 'Admin',
                authorId: r.author?.id || 1,
                excerpt: excerpt
            };
        });
    };

    const promises = layoutBlocks.filter((b: any) => b && b.type).map(async (block) => {
        if (block.type === 'hero' || block.type === 'hero_2' || block.type === 'hero_3') {
            blockData[block.id] = await fetchArticles({ limit: block.limit || 5 });
        } else if (block.type === 'category_block') {
            blockData[block.id] = await fetchArticles({ 
                categoryId: block.categoryId, 
                filterTaxonomyId: block.filterTaxonomyId,
                filterTermId: block.filterTermId,
                limit: block.limit || 5, 
                tagSlug: block.tagSlug 
            });
        } else if (block.type === 'category_block_2') {
            blockData[block.id] = await fetchArticles({ 
                categoryId: block.categoryId, 
                filterTaxonomyId: block.filterTaxonomyId,
                filterTermId: block.filterTermId,
                limit: block.limit || 11, 
                tagSlug: block.tagSlug 
            });
        } else if (block.type === 'categories_grid') {
            let priorityTax = block.taxonomySlug || 'categories';
        if (priorityTax === 'all') {
            const _allCols = await db.select().from(collections);
            const allColsForTax = _allCols.filter((c: any) => {
                const fields = safeJsonParse(c.fields || '[]', []);
                return !fields.some((f: any) => f.slug === 'isBlockBuilder' || f.slug === 'is_block_builder');
            });
            priorityTax = 'categories';
            for(const col of allColsForTax) {
                const supports = safeJsonParse(col.supports || '{}', {});
                if (supports.taxonomies && supports.taxonomies.length > 0) {
                    priorityTax = supports.taxonomies[0];
                    break;
                }
            }
        }
        const catTax = await db.select().from(taxonomies).where(eq(taxonomies.slug, priorityTax)).limit(1);
            if (catTax.length > 0) {
                blockData[block.id] = await db.select().from(terms).where(eq(terms.taxonomyId, catTax[0].id)).limit(block.limit || 12).offset(5);
            } else {
                blockData[block.id] = [];
            }
        }
    });

    await Promise.all(promises);
}

// Use the configured canonical site URL for structured data so cached HTML
// is correct no matter which host rendered it (localhost, preview, r2 domain).
// NOTE: db is block-scoped inside the `if (env && env.DB)` guard above, so this
// must live inside that block or re-acquire the handle.
let siteUrl = Astro.url.origin;
if (env && (env as any).DB) {
    try {
        const db2 = getDb(env as any);
        const gs = await db2.select({ value: settings.value }).from(settings).where(eq(settings.key, 'general_settings')).limit(1);
        if (gs.length > 0) {
            const parsed = JSON.parse(gs[0].value);
            if (parsed.siteUrl) siteUrl = parsed.siteUrl;
        }
    } catch (e) {}
}

const schemaObj = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Waritaku",
    "url": siteUrl,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/search?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
};
const schemaString = JSON.stringify(schemaObj);

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---

<LayoutFrontPage title={metaTitle} metaDescription={metaDescription} schema={schemaString} headerStyle={headerStyle} footerStyle={footerStyle}>
    <BlockRenderer 
        layoutBlocks={layoutBlocks} 
        blockData={blockData} 
        showLeftSidebar={showLeftSidebar} 
        showRightSidebar={showRightSidebar} 
    />
</LayoutFrontPage>
