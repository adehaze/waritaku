---
import { getThumbnail } from '../lib/utils';
import Layout from '../layouts/Layout.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import { entries as articlesTable, users, collections } from '../db/schema';
import {  eq, and, desc, sql , ne } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../lib/db';
import { getCanonicalUrls } from '../lib/queries';

const query = Astro.url.searchParams.get('q') || '';
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10)) : 1;
const pageSize = 12;
const t = Astro.locals.t || ((k: string, f?: string) => f || k);

let searchResults: any[] = [];
let totalPages = 1;
let totalItems = 0;

if (env && (env as any).DB && query.trim().length >= 3) {
    const db = getDb(env as any);
    const searchTerm = `%${query}%`;
    
    const articlesCol = await db.select().from(collections).where(eq(collections.slug, 'articles')).limit(1);

    if (articlesCol.length > 0) {
        const colId = articlesCol[0].id;
        
        // Count Total Results
        const countQuery = db.select({ count: sql<number>`count(*)` })
            .from(articlesTable)
            .where(
                and(
                    eq(articlesTable.status, 'published'),
                    eq(articlesTable.collectionId, colId),
                    sql`json_extract(${articlesTable.data}, '$.title') LIKE ${searchTerm}`
                )
            );
            
        const countResult = await countQuery;
        totalItems = countResult[0]?.count || 0;
        totalPages = Math.ceil(totalItems / pageSize);

        // Fetch Page Results
        const articlesQuery = db.select({
            article: articlesTable,
            author: users
        })
        .from(articlesTable)
        .leftJoin(users, eq(articlesTable.authorId, users.id))
        .where(
            and(
                eq(articlesTable.status, 'published'),
                eq(articlesTable.collectionId, colId),
                sql`json_extract(${articlesTable.data}, '$.title') LIKE ${searchTerm}`
            )
        )
        .orderBy(desc(articlesTable.publishedAt))
        .limit(pageSize)
        .offset((currentPage - 1) * pageSize);

        const articlesResult = await articlesQuery;

        const entryIds = articlesResult.map(r => r.article.id);
        const canonicalMap = await getCanonicalUrls(db, entryIds);

        searchResults = await Promise.all(articlesResult.map(async r => {
            let data: any = {};
            try { data = JSON.parse(r.article.data || '{}'); } catch(e){}
            const rawContent = data.content || '';
            const textOnly = rawContent.replace(new RegExp('<[^>]+>', 'g'), '').replace(/\[caption[^\]]*\]|\[\/caption\]/g, '').trim();
            const excerpt = textOnly.length > 120 ? textOnly.substring(0, 120) + '...' : textOnly;
            
            const prefix = canonicalMap[r.article.id];
            const canonicalUrl = prefix ? `/${prefix}/${r.article.slug}` : `/${r.article.slug}`;
            
            return {
                ...r.article,
                ...data,
                canonicalUrl,
                authorName: r.author?.name || 'Writer',
                excerpt
            };
        }));
    }
}

---

<Layout title={query ? `Search Results for "${query}"` : 'Search'} noindex={true}>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12">
            
            {/* Main Content */}
            <div class="lg:col-span-2">
                <div class="mb-12 border-b-4 border-primary inline-block">
                    <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground mb-4">
                        {t('search.results_for', 'Search Results for "{query}"').replace('{query}', query)}
                    </h1>
                    <p class="text-muted-foreground font-medium">{t('search.found_articles', 'Found {total} articles').replace('{total}', totalItems.toString())}</p>
                </div>
                
                {searchResults.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
                        {searchResults.map(article => (
                            <a href={article.canonicalUrl || `/${article.slug}`} class="group flex flex-col gap-3 bg-muted/20 border border-border rounded-xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
                                <div class="relative aspect-video w-full overflow-hidden">
                                    <img 
                                        src={article.featuredImageUrl || article.featuredImage || article.image || article.heroImage || article.thumbnail || getThumbnail(article.content)} 
                                        alt={article.title} 
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                        loading="lazy" 
                                    />
                                </div>
                                <div class="p-4 flex flex-col flex-1">
                                    <div class="flex items-center space-x-2 text-[10px] uppercase font-bold tracking-wider mb-2 text-muted-foreground">
                                        <span>{article.authorName}</span>
                                        <span>&bull;</span>
                                        <time>{new Date(article.publishedAt).toLocaleDateString()}</time>
                                    </div>
                                    <h3 class="text-base md:text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3 mb-2">
                                        {article.title}
                                    </h3>
                                    <p class="text-xs text-muted-foreground line-clamp-2 mt-auto">
                                        {article.excerpt}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="bg-muted/30 border border-border rounded-2xl p-12 text-center">
                        <svg class="w-16 h-16 mx-auto text-muted-foreground mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <h2 class="text-2xl font-bold text-foreground mb-2">{t('search.no_results', 'No results found')}</h2>
                        <p class="text-muted-foreground">{t('search.try_adjusting', 'Try adjusting your search query or finding something else.')}</p>
                    </div>
                )}

                {/* Pagination Controls */}
                {totalPages > 1 && (
                    <div class="flex items-center justify-between border-t border-border pt-6 mt-12">
                        {currentPage > 1 ? (
                            <a href={`/search?q=${encodeURIComponent(query)}&page=${currentPage - 1}`} class="px-6 py-3 bg-muted text-foreground font-bold rounded-lg hover:bg-primary hover:text-primary-foreground transition-colors">
                                &laquo; {t('common.previous', 'Previous')}
                            </a>
                        ) : (
                            <div></div>
                        )}
                        
                        <span class="text-sm font-semibold text-muted-foreground">
                            {t('common.page', 'Page')} {currentPage} {t('common.of', 'of')} {totalPages}
                        </span>

                        {currentPage < totalPages ? (
                            <a href={`/search?q=${encodeURIComponent(query)}&page=${currentPage + 1}`} class="px-6 py-3 bg-muted text-foreground font-bold rounded-lg hover:bg-primary hover:text-primary-foreground transition-colors">
                                {t('common.next', 'Next')} &raquo;
                            </a>
                        ) : (
                            <div></div>
                        )}
                    </div>
                )}
            </div>

            {/* Sidebar */}
            <aside class="lg:col-span-1 mt-12 lg:mt-0">
                <GlobalSidebar />
            </aside>

        </div>
    </div>
</Layout>
