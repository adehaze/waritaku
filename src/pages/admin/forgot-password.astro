---
import { sanitizeHtml } from '../../utils/sanitize';
import '../../styles/global.css';
import { settings, users, passwordResets } from '../../db/schema';
import { eq, or, sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import TurnstileWidget from '../../components/TurnstileWidget.astro';
import { verifyTurnstileToken } from '../../lib/turnstile';

let message = '';
let isError = false;
let systemLoginHtml = '';
let senderEmail = 'noreply@resend.waritaku.com';

if (env && (env as any).DB) {
    const db = getDb(env as any);
    try {
        const configRow = await db.select().from(settings).where(eq(settings.key, 'general_settings')).limit(1);
        if (configRow.length > 0) {
            const config = JSON.parse(configRow[0].value);
            systemLoginHtml = config.systemLoginHtml || '';
        }
        
        const secretsRow = await db.select().from(settings).where(eq(settings.key, 'system_secrets')).limit(1);
        if (secretsRow.length > 0) {
            const secrets = JSON.parse(secretsRow[0].value);
            if (secrets.senderEmail) senderEmail = secrets.senderEmail;
        }
    } catch(e) {}
}

if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const email = formData.get('email') as string;
        const turnstileToken = (formData.get('cf-turnstile-response') as string) || '';

        const turnstileSecret = (env as any)?.TURNSTILE_SECRET || process.env.TURNSTILE_SECRET;
        const clientIp = Astro.request.headers.get('cf-connecting-ip') || Astro.clientAddress;
        const turnstileResult = await verifyTurnstileToken(turnstileToken, turnstileSecret, clientIp);

        if (!turnstileResult.success) {
            isError = true;
            message = turnstileResult.error || 'Security verification failed. Please try again.';
        } else if (!email) {
            isError = true;
            message = 'Please enter your email address.';
        } else if (env && (env as any).DB) {
            const db = getDb(env as any);
            const loginInput = email.trim().toLowerCase();
            const userResult = await db.select().from(users).where(
                or(
                    eq(sql`lower(${users.email})`, loginInput),
                    eq(sql`lower(${users.slug})`, loginInput)
                )
            ).limit(1);
            
            // For security, do not reveal if the email exists or not. Always show success message.
            if (userResult.length > 0) {
                const user = userResult[0];
                const token = [...crypto.getRandomValues(new Uint8Array(32))].map(b => b.toString(16).padStart(2, '0')).join('');
                // Token expires in 1 hour
                const expiresAt = new Date(Date.now() + 60 * 60 * 1000);

                await db.insert(passwordResets).values({
                    userId: user.id,
                    token: token,
                    expiresAt: expiresAt
                });

                const resetLink = `${Astro.url.origin}/admin/reset-password?token=${token}`;
                
                const resendApiKey = (env as any).RESEND_API_KEY;
                if (resendApiKey) {
                    const res = await fetch('https://api.resend.com/emails', {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${resendApiKey}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            from: `Waritaku CMS <${senderEmail}>`,
                            to: [user.email],
                            subject: 'Password Reset Request',
                            html: `<div style="font-family: sans-serif; max-w-md; margin: 0 auto;">
                                <h2>Password Reset</h2>
                                <p>You recently requested to reset your password for your account.</p>
                                <p>Click the button below to reset it. This link will expire in 1 hour.</p>
                                <a href="${resetLink}" style="display:inline-block; padding: 10px 20px; background-color: #000; color: #fff; text-decoration: none; border-radius: 5px;">Reset Password</a>
                                <p style="margin-top:20px; font-size:12px; color:#666;">If you did not request this, you can safely ignore this email.</p>
                            </div>`
                        })
                    });
                    
                    if (!res.ok) {
                        console.error('Failed to send Resend email:', await res.text());
                    }
                } else {
                    console.error('RESEND_API_KEY not found in environment. Email not sent.');
                }
            }

            isError = false;
            message = 'If an account exists with that email, a password reset link has been sent.';
        }
    } catch(e) {
        console.error(e);
        isError = true;
        message = 'An error occurred while processing your request.';
    }
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waritaku - Forgot Password</title>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="bg-background text-foreground flex min-h-screen">

<!-- Left Side: Login Box -->
<div class="w-full lg:w-1/2 flex items-center justify-center p-8 lg:p-12 bg-background relative z-10">
    <div class="w-full max-w-md space-y-8">
        <div class="text-center space-y-2 mb-10">
            <div class="flex justify-center mb-6">
                <div class="w-16 h-16 bg-primary text-primary-foreground rounded-2xl flex items-center justify-center shadow-lg transform -rotate-3 hover:rotate-0 transition-transform cursor-pointer">
                    <span class="font-black text-4xl tracking-tighter">W</span>
                </div>
            </div>
            <h1 class="text-3xl font-bold tracking-tight">Forgot Password</h1>
            <p class="text-muted-foreground text-sm">Enter your email or username to receive a reset link.</p>
        </div>

        {message && (
            <div class={`text-sm font-medium p-4 rounded-xl mb-6 text-center border shadow-sm ${isError ? 'bg-destructive/15 text-destructive border-destructive/20' : 'bg-emerald-500/15 text-emerald-500 border-emerald-500/20'}`}>
                {message}
            </div>
        )}

        <form method="POST" class="space-y-5">
            <div class="space-y-2">
                <label for="email" class="text-sm font-bold tracking-wide uppercase text-muted-foreground">Email or Username</label>
                <input 
                    type="text" 
                    id="email" 
                    name="email" 
                    required 
                    class="flex h-12 w-full rounded-xl border-2 border-input bg-background/50 px-4 py-2 text-base ring-offset-background placeholder:text-muted-foreground/50 focus-visible:outline-none focus-visible:border-primary focus-visible:ring-4 focus-visible:ring-primary/20 transition-all"
                    placeholder="you@example.com or username"
                />
            </div>
            
            <div class="flex justify-center pt-2 min-h-[65px]">
                <TurnstileWidget theme="dark" action="forgot-password" />
            </div>

            <button type="submit" class="w-full h-12 mt-8 bg-primary text-primary-foreground font-bold tracking-widest uppercase rounded-xl shadow-md hover:bg-primary/90 hover:shadow-lg hover:-translate-y-0.5 transition-all active:translate-y-0">
                Send Reset Link
            </button>
            
            <p class="text-xs text-center text-muted-foreground mt-8 leading-relaxed">
                Remember your password? <a href="/admin/login" class="underline hover:text-foreground">Back to Login</a>
            </p>
        </form>
    </div>
</div>

<!-- Right Side: Configurable Display -->
<div class="hidden lg:flex lg:w-1/2 bg-muted relative overflow-hidden items-center justify-center">
    {systemLoginHtml ? (
        <div set:html={sanitizeHtml(systemLoginHtml)} class="w-full h-full [&>img]:w-full [&>img]:h-full [&>img]:object-cover" />
    ) : (
        <div class="w-full h-full relative">
            <img src="https://r2.waritaku.com/Assets/photo-1618005182384-a83a8bd57fbe.jpg?q=80&w=2564&auto=format&fit=crop" class="w-full h-full object-cover opacity-90" alt="Waritaku Default Login Background" />
            <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-12 left-12 right-12">
                <h2 class="text-4xl font-black text-white mb-2 drop-shadow-md"><a href="https://github.com/AdeHaze/waritaku" class="underline hover:text-foreground">Waritaku CMS</a></h2>
                <p class="text-white/80 text-lg font-medium drop-shadow-md">You, who have fallen to the abyss.</p>
            </div>
        </div>
    )}
</div>

</body>
</html>
