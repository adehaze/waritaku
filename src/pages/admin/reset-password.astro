---
import { sanitizeHtml } from '../../utils/sanitize';
import '../../styles/global.css';
import { settings, users, passwordResets } from '../../db/schema';
import { eq, and, gt } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb } from '../../lib/db';
import { hashPassword } from '../../lib/auth';
import TurnstileWidget from '../../components/TurnstileWidget.astro';
import { verifyTurnstileToken } from '../../lib/turnstile';

let message = '';
let isError = false;
let isValidToken = false;
let tokenStr = Astro.url.searchParams.get('token');
let userId: number | null = null;
let systemLoginHtml = '';

if (env && (env as any).DB) {
    const db = getDb(env as any);
    try {
        const configRow = await db.select().from(settings).where(eq(settings.key, 'general_settings')).limit(1);
        if (configRow.length > 0) {
            const config = JSON.parse(configRow[0].value);
            systemLoginHtml = config.systemLoginHtml || '';
        }
    } catch(e) {}
}

let db: any = null;
if (env && (env as any).DB) {
    db = getDb(env as any);
}

if (!tokenStr) {
    isError = true;
    message = 'No reset token provided.';
} else if (db) {
    // Check if token is valid and not expired
    const now = new Date();
    const tokenResult = await db.select().from(passwordResets).where(and(eq(passwordResets.token, tokenStr), gt(passwordResets.expiresAt, now))).limit(1);
    
    if (tokenResult.length > 0) {
        isValidToken = true;
        userId = tokenResult[0].userId;
    } else {
        isError = true;
        message = 'The reset token is invalid or has expired.';
    }
}

if (Astro.request.method === 'POST' && isValidToken && db && userId) {
    // Rate limiting: 5 attempts max, 60s cooldown
    const rateCookie = Astro.cookies.get('reset_rate');
    let attempts = 0;
    let cooldownUntil = 0;
    if (rateCookie) {
        try {
            const parsed = JSON.parse(rateCookie.value);
            attempts = parsed.a || 0;
            cooldownUntil = parsed.t || 0;
        } catch {}
    }
    const now = Date.now();
    if (cooldownUntil > now) {
        const waitSeconds = Math.ceil((cooldownUntil - now) / 1000);
        isError = true;
        message = `Too many attempts. Please wait ${waitSeconds} seconds.`;
    } else {
    try {
        const formData = await Astro.request.formData();
        const password = formData.get('password') as string;
        const confirmPassword = formData.get('confirmPassword') as string;
        const turnstileToken = (formData.get('cf-turnstile-response') as string) || '';

        const turnstileSecret = (env as any)?.TURNSTILE_SECRET || process.env.TURNSTILE_SECRET;
        const clientIp = Astro.request.headers.get('cf-connecting-ip') || Astro.clientAddress;
        const turnstileResult = await verifyTurnstileToken(turnstileToken, turnstileSecret, clientIp);

        if (!turnstileResult.success) {
            isError = true;
            message = turnstileResult.error || 'Security verification failed. Please try again.';
            attempts++;
        } else if (!password || password.length < 8) {
            isError = true;
            message = 'Password must be at least 8 characters long.';
            attempts++;
        } else if (password !== confirmPassword) {
            isError = true;
            message = 'Passwords do not match.';
            attempts++;
        } else {
            const hashedPassword = await hashPassword(password);
            
            // Update user password
            await db.update(users).set({ passwordHash: hashedPassword }).where(eq(users.id, userId));
            
            // Delete the used token
            await db.delete(passwordResets).where(eq(passwordResets.token, tokenStr as string));
            
            isValidToken = false; // Hide the form
            isError = false;
            message = 'Your password has been successfully reset. You may now login.';
        }
    } catch(e) {
        console.error(e);
        isError = true;
        message = 'An error occurred while resetting your password.';
        attempts++;
    }
    // Set rate limit cookie after failed attempt
    if (attempts > 0) {
        const ratePayload = { a: attempts, t: attempts >= 5 ? Date.now() + 60000 : 0 };
        Astro.cookies.set('reset_rate', JSON.stringify(ratePayload), { path: '/admin/reset-password', maxAge: 300, httpOnly: true, sameSite: 'lax' });
    }
    } // end rate-check else
}
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waritaku - Reset Password</title>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="bg-background text-foreground flex min-h-screen">

<!-- Left Side: Login Box -->
<div class="w-full lg:w-1/2 flex items-center justify-center p-8 lg:p-12 bg-background relative z-10">
    <div class="w-full max-w-md space-y-8">
        <div class="text-center space-y-2 mb-10">
            <div class="flex justify-center mb-6">
                <div class="w-16 h-16 bg-primary text-primary-foreground rounded-2xl flex items-center justify-center shadow-lg transform -rotate-3 hover:rotate-0 transition-transform cursor-pointer">
                    <span class="font-black text-4xl tracking-tighter">W</span>
                </div>
            </div>
            <h1 class="text-3xl font-bold tracking-tight">Reset Password</h1>
            <p class="text-muted-foreground text-sm">Create a new secure password.</p>
        </div>

        {message && (
            <div class={`text-sm font-medium p-4 rounded-xl mb-6 text-center border shadow-sm ${isError ? 'bg-destructive/15 text-destructive border-destructive/20' : 'bg-emerald-500/15 text-emerald-500 border-emerald-500/20'}`}>
                {message}
            </div>
        )}

        {isValidToken ? (
            <form method="POST" class="space-y-5">
                <div class="space-y-2">
                    <label for="password" class="text-sm font-bold tracking-wide uppercase text-muted-foreground">New Password</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required 
                        class="flex h-12 w-full rounded-xl border-2 border-input bg-background/50 px-4 py-2 text-base ring-offset-background placeholder:text-muted-foreground/50 focus-visible:outline-none focus-visible:border-primary focus-visible:ring-4 focus-visible:ring-primary/20 transition-all"
                    />
                </div>
                
                <div class="space-y-2">
                    <label for="confirmPassword" class="text-sm font-bold tracking-wide uppercase text-muted-foreground">Confirm Password</label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        required 
                        class="flex h-12 w-full rounded-xl border-2 border-input bg-background/50 px-4 py-2 text-base ring-offset-background placeholder:text-muted-foreground/50 focus-visible:outline-none focus-visible:border-primary focus-visible:ring-4 focus-visible:ring-primary/20 transition-all"
                    />
                </div>
                
                <div class="flex justify-center pt-2">
                    <TurnstileWidget theme="dark" action="reset-password" />
                </div>
                
                <button type="submit" class="w-full h-12 mt-8 bg-primary text-primary-foreground font-bold tracking-widest uppercase rounded-xl shadow-md hover:bg-primary/90 hover:shadow-lg hover:-translate-y-0.5 transition-all active:translate-y-0">
                    Save New Password
                </button>
            </form>
        ) : (
            <div class="mt-6 text-center">
                <a href="/admin/login" class="inline-flex items-center justify-center h-12 px-8 bg-foreground text-background font-bold uppercase tracking-widest rounded-xl hover:bg-primary transition-colors">Return to Login</a>
            </div>
        )}
    </div>
</div>

<!-- Right Side: Configurable Display -->
<div class="hidden lg:flex lg:w-1/2 bg-muted relative overflow-hidden items-center justify-center">
    {systemLoginHtml ? (
        <div set:html={sanitizeHtml(systemLoginHtml)} class="w-full h-full [&>img]:w-full [&>img]:h-full [&>img]:object-cover" />
    ) : (
        <div class="w-full h-full relative">
            <img src="https://r2.waritaku.com/Assets/photo-1618005182384-a83a8bd57fbe.jpg?q=80&w=2564&auto=format&fit=crop" class="w-full h-full object-cover opacity-90" alt="Waritaku Default Login Background" />
            <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-12 left-12 right-12">
                <h2 class="text-4xl font-black text-white mb-2 drop-shadow-md">Create Without Limits</h2>
                <p class="text-white/80 text-lg font-medium drop-shadow-md">You can customize this image in Settings &gt; System Login HTML.</p>
            </div>
        </div>
    )}
</div>

</body>
</html>
