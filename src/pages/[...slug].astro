---

function safeJsonParse(str: string, fallback: any) { try { return JSON.parse(str); } catch(e) { return fallback; } }
import { getThumbnail } from '../lib/utils';
import LayoutArticlePage from '../layouts/LayoutArticlePage.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Pagination from '../components/Pagination.astro';
import ViewToggle from '../components/ViewToggle.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import ModularTemplateRenderer from '../components/ModularTemplateRenderer.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../lib/db';
import { resolveRouteData } from '../lib/queries';
import { settings, entries, collections, users, taxonomies, terms, entryTerms } from '../db/schema';
import {  eq, and, or, desc, sql, inArray, exists , ne } from 'drizzle-orm';

import { parseEmbeds } from '../utils/embedParser';
import IndexPage from './index.astro';

let rawSlug = Astro.params.slug as string;
let isHomepageFallback = false;
const t = Astro.locals.t || ((k: string, f?: string) => f || k);

if (!rawSlug) {
    isHomepageFallback = true;
} else {
    rawSlug = rawSlug.replace(/\/$/, '');
}

// Return 404 for missing static assets without querying D1 or redirecting to /404 HTML
if (rawSlug && rawSlug.startsWith('_astro/')) {
    return new Response('Not Found', {
        status: 404,
        headers: { 'Content-Type': 'text/plain', 'Cache-Control': 'public, max-age=3600' }
    });
}

let currentPage = 1;
const pageMatch = rawSlug.match(/^(.*?)\/page\/(\d+)$/i);
if (pageMatch) {
    rawSlug = pageMatch[1];
    currentPage = Math.max(1, parseInt(pageMatch[2], 10));
} else {
    const pageParam = Astro.url.searchParams.get('page');
    if (pageParam) currentPage = Math.max(1, parseInt(pageParam, 10));
}

const slug = rawSlug;
const pageSize = 12;

let pageType: string | null = null;
let data: any = null;
let categoryArticles: any[] = [];
let termsList: any[] = [];
let totalPages = 1;
let articleUpperHtml = '';
let articleBottomHtml = '';
let archiveInBetweenHtml = '';

let showLeftSidebar = false;
let showRightSidebar = true;
let headerStyle = 'default';
let footerStyle = 'default';

let layoutBlocks: any[] = [];
let blockData: Record<string, any> = {};

if (!isHomepageFallback && env && env.DB && slug) {
  const db = getDb(env);
  const sortTermBy = Astro.url.searchParams.get('sort') || 'popular';
  const options = { dateArchiveMode: (Astro.locals as any).generalSettings?.dateArchiveMode };
  const resolved = await resolveRouteData(db, slug, currentPage, pageSize, sortTermBy, options);
  if (resolved) {
      if (resolved.redirect) {
          return Astro.redirect(resolved.redirect, 301);
      }
      pageType = resolved.pageType;
      data = resolved.data;
      categoryArticles = resolved.categoryArticles;
      termsList = resolved.termsList || [];
      totalPages = resolved.totalPages || 1;
            articleUpperHtml = resolved.articleUpperHtml || '';
      articleBottomHtml = resolved.articleBottomHtml || '';

      if (data && data.canonicalUrl && (pageType === 'category' || pageType === 'taxonomy_archive')) {
          let expectedPath = data.canonicalUrl;
          if (currentPage > 1) {
              expectedPath = `${expectedPath}/page/${currentPage}`;
          }
          
          let currentPath = Astro.url.pathname;
          if (currentPath.endsWith('/') && currentPath !== '/') {
              currentPath = currentPath.slice(0, -1);
          }
          
          if (currentPath !== expectedPath) {
              return Astro.redirect(expectedPath, 301);
          }
      }

  }
  
  if (pageType) {
      // Sidebar and Theme Overrides
      const configRes = await db.select().from(settings).where(inArray(settings.key, ['sidebar_layout_config', 'homepage_page_id']));
      
      const homepageSetting = configRes.find(s => s.key === 'homepage_page_id');
      const homepageId = homepageSetting ? parseInt(homepageSetting.value, 10) : null;

      // Strict redirect: If this page is the homepage, enforce the root URL (/)
      if (pageType === 'page' && data.id === homepageId && !isHomepageFallback) {
          return Astro.redirect('/', 301);
      }

      const sidebarSetting = configRes.find(s => s.key === 'sidebar_layout_config');
      
      if (pageType === 'page') {
          headerStyle = data.headerStyle || 'default';
          footerStyle = data.footerStyle || 'default';
          
          let pageOverride = null;
          if (data.layout_config) {
              try {
                  pageOverride = typeof data.layout_config === 'string' ? JSON.parse(data.layout_config) : data.layout_config;
              } catch(e) {}
          }
          if (pageOverride && pageOverride.override) {
              showLeftSidebar = pageOverride.showLeft;
              showRightSidebar = pageOverride.showRight;
          } else if (sidebarSetting) {
              try {
                  const layoutConfig = JSON.parse(sidebarSetting.value);
                  showLeftSidebar = layoutConfig.left?.showOnArticles ?? false;
                  showRightSidebar = layoutConfig.right?.showOnArticles ?? true;
              } catch(e) {}
          }

          // Handle Block Builder Data
          if (data.is_block_builder && data.layout_blocks) {
              try {
                  layoutBlocks = typeof data.layout_blocks === 'string' ? JSON.parse(data.layout_blocks) : data.layout_blocks;
              } catch(e) {}

              const fetchArticles = async (options: { 
                  categoryId?: string | number, 
                  filterTaxonomyId?: string | number,
                  filterTermId?: string | number,
                  filters?: { taxonomyId?: string, termId?: string }[],
                  filterMatchType?: string,
                  collectionId?: string,
                  limit?: number, 
                  offset?: number, 
                  isRandom?: boolean, 
                  tagSlug?: string 
              } = {}) => {
                  const { categoryId, filterTaxonomyId, filterTermId, filters = [], filterMatchType = 'AND', collectionId = null, limit = 5, offset = 0, isRandom = false, tagSlug } = options;
                  
                  let contentColIds = [];
                    if (collectionId) {
                        const targetColResult = await db.select({ id: collections.id }).from(collections).where(eq(collections.slug, collectionId)).limit(1);
                        if (targetColResult.length > 0) contentColIds.push(targetColResult[0].id);
                    } else {
                        const allCols = await db.select({ id: collections.id }).from(collections).where(ne(collections.slug, 'pages'));
                        contentColIds = allCols.map(c => c.id);
                    }
                    if (contentColIds.length === 0) return [];
                  
                  let query = db.select({
                      entry: entries,
                      author: users
                  })
                  .from(entries)
                  .leftJoin(users, eq(entries.authorId, users.id));

                  let conditions: any = and(eq(entries.status, 'published'), inArray(entries.collectionId, contentColIds));

                  const hasLegacyFilter = (categoryId && categoryId !== 'all') || tagSlug;
                  const hasTaxonomyFilter = filterTaxonomyId && filterTaxonomyId !== 'all';
                  const hasTermFilter = filterTermId && filterTermId !== 'all';
                  
                  // Filter out empty entries from the new filters array
                  const activeFilters = filters.filter(f => f.taxonomyId && f.taxonomyId !== 'all');

                  if (activeFilters.length > 0) {
                      if (filterMatchType === 'AND') {
                          // Match ALL specified filters (Intersection)
                          for (const f of activeFilters) {
                              const termCond = (f.termId && f.termId !== 'all') 
                                  ? eq(terms.id, parseInt(f.termId as string)) 
                                  : eq(terms.taxonomyId, parseInt(f.taxonomyId as string));
                              
                              const existsQuery = db.select({ id: sql`1` })
                                  .from(entryTerms)
                                  .innerJoin(terms, eq(entryTerms.termId, terms.id))
                                  .where(and(eq(entryTerms.entryId, entries.id), termCond));
                                  
                              conditions = and(conditions, exists(existsQuery));
                          }
                      } else {
                          // Match ANY of the specified filters (Union)
                          query = query.innerJoin(entryTerms, eq(entries.id, entryTerms.entryId));
                          query = query.innerJoin(terms, eq(entryTerms.termId, terms.id));
                          
                          const orConditions = activeFilters.map(f => {
                              if (f.termId && f.termId !== 'all') {
                                  return eq(terms.id, parseInt(f.termId as string));
                              }
                              return eq(terms.taxonomyId, parseInt(f.taxonomyId as string));
                          });
                          
                          conditions = and(conditions, or(...orConditions));
                      }
                  } else if (hasLegacyFilter || hasTaxonomyFilter || hasTermFilter) {
                      query = query.innerJoin(entryTerms, eq(entries.id, entryTerms.entryId));
                      query = query.innerJoin(terms, eq(entryTerms.termId, terms.id));
                      
                      const termConditions = [];
                      
                      // New Filter System
                      if (hasTermFilter) {
                          termConditions.push(eq(terms.id, parseInt(filterTermId as string)));
                      } else if (hasTaxonomyFilter) {
                          termConditions.push(eq(terms.taxonomyId, parseInt(filterTaxonomyId as string)));
                      }
                      
                      // Legacy Backwards Compatibility
                      if (!hasTermFilter && !hasTaxonomyFilter) {
                          if (categoryId && categoryId !== 'all') {
                              termConditions.push(eq(terms.id, parseInt(categoryId as string)));
                          }
                          if (tagSlug) {
                              termConditions.push(eq(terms.slug, tagSlug));
                          }
                      }

                      if (termConditions.length > 0) {
                          conditions = and(conditions, ...termConditions);
                      }
                  }

                  const hasJoin = activeFilters.length > 0 || hasLegacyFilter || hasTaxonomyFilter || hasTermFilter;
                  query = query.where(conditions) as any;
                  if (hasJoin) {
                      query = query.groupBy(entries.id) as any;
                  }

                  if (isRandom) {
                      query = query.orderBy(sql`RANDOM()`) as any;
                  } else {
                      query = query.orderBy(desc(entries.id)) as any;
                  }

                  const result = await query.limit(limit).offset(offset);
                  
                  return result.map(r => {
                      let blkData: any;
                      try { blkData = JSON.parse(r.entry.data || '{}'); } catch { blkData = {}; }
                      const rawContent = blkData.content || '';
                      const textOnly = rawContent.replace(/<[^>]+>/g, '').replace(/\[caption[^\]]*\]|\[\/caption\]/g, '').trim();
                      const excerpt = textOnly.length > 120 ? textOnly.substring(0, 120) + '...' : textOnly;

                      return {
                          id: r.entry.id,
                          slug: r.entry.slug,
                          publishedAt: r.entry.publishedAt,
                          ...blkData,
                          categoryName: 'Entry', // Dynamically use collection label
                          categorySlug: 'all',
                          authorName: r.author?.name || 'Admin',
                          authorId: r.author?.id || 1,
                          excerpt: excerpt
                      };
                  });
              };

              const promises = layoutBlocks.map(async (block) => {
                  if (block.type === 'hero' || block.type === 'hero_2' || block.type === 'hero_3') {
                      blockData[block.id] = await fetchArticles({ limit: block.limit || 5, collectionId: block.collectionId });
                  } else if (block.type === 'category_block') {
                      blockData[block.id] = await fetchArticles({ 
                          categoryId: block.categoryId, 
                          filterTaxonomyId: block.filterTaxonomyId,
                          filterTermId: block.filterTermId,
                          filters: block.filters,
                          filterMatchType: block.filterMatchType,
                          collectionId: block.collectionId,
                          limit: block.limit || 5, 
                          tagSlug: block.tagSlug 
                      });
                  } else if (block.type === 'category_block_2') {
                      blockData[block.id] = await fetchArticles({ 
                          categoryId: block.categoryId, 
                          filterTaxonomyId: block.filterTaxonomyId,
                          filterTermId: block.filterTermId,
                          filters: block.filters,
                          filterMatchType: block.filterMatchType,
                          collectionId: block.collectionId,
                          limit: block.limit || 11, 
                          tagSlug: block.tagSlug 
                      });
                  } else if (block.type === 'article_grid') {
                      blockData[block.id] = await fetchArticles({ limit: block.limit || 12, isRandom: true });
                  } else if (block.type === 'categories_grid') {
                      // Fetch categories from terms where taxonomy is 'categories'
                      let priorityTax = block.taxonomySlug || 'categories';
        if (priorityTax === 'all') {
            const _allCols = await db.select().from(collections);
            const allColsForTax = _allCols.filter((c: any) => {
                const fields = safeJsonParse(c.fields || '[]', []);
                return !fields.some((f: any) => f.slug === 'isBlockBuilder' || f.slug === 'is_block_builder');
            });
            priorityTax = 'categories';
            for(const col of allColsForTax) {
                const supports = safeJsonParse(col.supports || '{}', {});
                if (supports.taxonomies && supports.taxonomies.length > 0) {
                    priorityTax = supports.taxonomies[0];
                    break;
                }
            }
        }
        const catTax = await db.select().from(taxonomies).where(eq(taxonomies.slug, priorityTax)).limit(1);
                      if (catTax.length > 0) {
                          blockData[block.id] = await db.select().from(terms).where(eq(terms.taxonomyId, catTax[0].id)).limit(block.limit || 12).offset(5);
                      } else {
                          blockData[block.id] = [];
                      }
                  }
              });

              await Promise.all(promises);
          }
      } else {
          // Article or Category Global Sidebars
          if (sidebarSetting) {
              try {
                  const layoutConfig = JSON.parse(sidebarSetting.value);
                  const ctx = pageType === 'category' ? 'category' : 'article';
                  showLeftSidebar = layoutConfig.left?.[`showOn${ctx.charAt(0).toUpperCase() + ctx.slice(1)}s`] ?? false;
                  showRightSidebar = layoutConfig.right?.[`showOn${ctx.charAt(0).toUpperCase() + ctx.slice(1)}s`] ?? true;
              } catch(e) {}
          }
      }
  }
}

if (!isHomepageFallback && (!data || !pageType)) {
  return Astro.redirect('/404');
}

// Handle Password Protection
let showPasswordPrompt = false;
let passwordError = '';

if (pageType === 'article' && data.visibility === 'password') {
    const cookieName = `article_access_${data.id}`;
    let hasAccess = false;

    const storedCookie = Astro.cookies.get(cookieName);
    if (storedCookie && data.password) {
        const enc = new TextEncoder();
        const hash = await crypto.subtle.digest('SHA-256', enc.encode(data.password + 'waritaku-salt'));
        const expected = btoa(String.fromCharCode(...new Uint8Array(hash)));
        hasAccess = (storedCookie.value === expected);
    }

    if (Astro.request.method === 'POST') {
        const formData = await Astro.request.formData();
        const inputPassword = formData.get('post_password') as string;
        if (inputPassword && inputPassword === data.password) {
            const enc = new TextEncoder();
            const hash = await crypto.subtle.digest('SHA-256', enc.encode(data.password + 'waritaku-salt'));
            const token = btoa(String.fromCharCode(...new Uint8Array(hash)));
            Astro.cookies.set(cookieName, token, { path: '/', maxAge: 60 * 60 * 24, httpOnly: true, secure: true, sameSite: 'lax' });
            hasAccess = true;
        } else {
            passwordError = 'Incorrect password.';
        }
    }

    if (!hasAccess) {
        showPasswordPrompt = true;
    }
}

let parsedContent = data.content || data.bodyContent || data.body_content || data.body || data.description || data.hero || data.text || '';
parsedContent = parsedContent.replace(/https?:\/\/(www\.)?waritaku\.com\/wp-content\/uploads/gi, '/uploads');
parsedContent = parsedContent.replace(/https?:\/\/(128\.199\.139\.85)\/wp-content\/uploads/gi, '/uploads');
parsedContent = parsedContent.replace(/https?:\/\/127\.0\.0\.1:\d+\/wp-content\/uploads/gi, '/uploads');
parsedContent = parsedContent.replace(/https?:\/\/localhost:\d+\/wp-content\/uploads/gi, '/uploads');
parsedContent = parsedContent.replace(/(\/uploads\/[^\s"'<>]+?)(-\d+x\d+)?\.(jpe?g|png)(?=["'\s>])/gi, '$1.webp');

parsedContent = parsedContent.replace(/\[caption[^\]]*\]([\s\S]*?)\[\/caption\]/gi, (match: string, innerHtml: string) => {
    const imgMatch = innerHtml.match(/(<a[^>]*>)?\s*(<img[^>]+>)\s*(<\/a>)?/i);
    if (imgMatch) {
        const fullImgHtml = imgMatch[0];
        const captionText = innerHtml.replace(fullImgHtml, '').trim();
        return `<figure class="my-8">${fullImgHtml}<figcaption class="text-center text-sm text-muted-foreground mt-2">${captionText}</figcaption></figure>`;
    }
    return match;
});

parsedContent = parsedContent.replace(/<img([^>]*)title="([^"]+)"([^>]*)>/gi, (match: string, before: string, title: string, after: string) => {
    return `<figure class="my-8"><img${before}title="${title}"${after}><figcaption class="text-center text-sm text-muted-foreground mt-2">${title}</figcaption></figure>`;
});

const fallbackAlt = (data.title || data.name || '').replace(/"/g, '&quot;');
parsedContent = parsedContent.replace(/<img([^>]*)>/gi, (match: string, attrs: string) => {
    if (!/alt="[^"]+"/i.test(attrs)) {
        let newAttrs = attrs.replace(/\s*alt=(["'])\1/gi, '');
        return `<img alt="${fallbackAlt}" ${newAttrs}>`;
    }
    return match;
});

parsedContent = parsedContent.replace(/\[faq title="([^"]+)"\]([\s\S]*?)\[\/faq\]/gi, (match: string, title: string, answer: string) => {
    return `<details class="group my-4 border border-border rounded-lg bg-card shadow-sm overflow-hidden"><summary class="flex justify-between items-center cursor-pointer p-4 font-semibold hover:bg-muted/50 transition-colors"><span>${title}</span><span class="transition-transform group-open:rotate-180">▼</span></summary><div class="p-4 border-t border-border text-muted-foreground">${answer.trim()}</div></details>`;
});

parsedContent = parseEmbeds(parsedContent);

function generateToC(html: string) {
    let tocHtml = `<div class="my-8 bg-muted/10 border-2 border-border/50 p-6 rounded-2xl shadow-sm"><h3 class="text-xl font-black mb-4 uppercase tracking-widest text-primary border-l-4 border-primary pl-3">${t('article.table_of_contents', 'Table of Contents')}</h3><ul class="space-y-3">`;
    let hasHeadings = false;
    let counter = 1;
    
    const modifiedHtml = html.replace(/<(h[23])[^>]*>(.*?)<\/\1>/gi, (match: string, tag: string, text: string) => {
        hasHeadings = true;
        const rawText = text.replace(/<[^>]+>/g, '').trim();
        const id = `toc-${counter++}`;
        const padding = tag.toLowerCase() === 'h3' ? 'pl-6 text-sm text-muted-foreground' : 'font-bold text-foreground';
        const icon = tag.toLowerCase() === 'h3' ? '↳' : '•';
        
        tocHtml += `<li class="${padding} transition-colors hover:text-primary"><a href="#${id}" class="flex items-start gap-2"><span class="text-primary/70">${icon}</span> <span>${rawText}</span></a></li>`;
        
        return `<${tag} id="${id}" class="scroll-mt-28">${text}</${tag}>`;
    });
    
    tocHtml += '</ul></div>';
    
    if (hasHeadings) {
        const firstParagraphEnd = modifiedHtml.indexOf('</p>');
        if (firstParagraphEnd !== -1 && firstParagraphEnd < 800) {
            return modifiedHtml.substring(0, firstParagraphEnd + 4) + tocHtml + modifiedHtml.substring(firstParagraphEnd + 4);
        }
        return tocHtml + modifiedHtml;
    }
    return html;
}

if (!data.is_block_builder) {
    if (data.content) {
        data.content = parseEmbeds(data.content);
    }
    parsedContent = generateToC(parsedContent);
}


const headerImage = data.featuredImageUrl || data.featuredImage || data.image || data.heroImage || data.thumbnail || data.coverImage || data.hero || getThumbnail(parsedContent);
const pageTitle = data.metaTitle || data.title || data.name;
// Use the configured canonical site URL for structured data so cached HTML
// is correct no matter which host rendered it (localhost, preview, r2 domain).
// NOTE: db is block-scoped inside the route-resolution guard above, so this
// must re-acquire the handle.
let siteUrl = Astro.url.origin;
let siteTitle = 'Waritaku';
let siteLogo = '/favicon.svg';
if (env && env.DB) {
    try {
        const db2 = getDb(env);
        const gs = await db2.select({ value: settings.value }).from(settings).where(eq(settings.key, 'general_settings')).limit(1);
        if (gs.length > 0) {
            const parsed = JSON.parse(gs[0].value);
            if (parsed.siteUrl) siteUrl = parsed.siteUrl;
            if (parsed.siteTitle) siteTitle = parsed.siteTitle;
            if (parsed.faviconUrl) siteLogo = parsed.faviconUrl;
            if (parsed.archiveInBetweenHtml) archiveInBetweenHtml = parsed.archiveInBetweenHtml;
        }
    } catch (e) {}
}
const currentUrl = `${siteUrl}${Astro.url.pathname}`;

let schemaObj: any = null;

if (pageType === 'article') {
    schemaObj = {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        "headline": pageTitle,
        "image": headerImage ? [
            headerImage.startsWith('http') ? headerImage : `${siteUrl}${headerImage}`
        ] : [],
        "datePublished": data.publishedAt || new Date().toISOString(),
        "dateModified": data.updatedAt || data.publishedAt || new Date().toISOString(),
        "author": [{
            "@type": "Person",
            "name": data.authorName || 'Writer',
            "url": `${siteUrl}/author/${data.authorSlug}`
        }],
        "publisher": {
            "@type": "Organization",
            "name": siteTitle,
            "logo": {
                "@type": "ImageObject",
                "url": siteLogo.startsWith('http') ? siteLogo : `${siteUrl}${siteLogo}`
            }
        }
    };
} else if (pageType === 'page') {
    schemaObj = {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": pageTitle,
        "url": currentUrl,
        "datePublished": data.publishedAt || new Date().toISOString()
    };
} else if (pageType === 'category') {
    schemaObj = {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": pageTitle,
        "url": currentUrl
    };
}

let schemaString = schemaObj ? JSON.stringify(schemaObj) : undefined;

let breadcrumbSchema: any = null;
if (data.supports?.breadcrumbs !== false) {
    breadcrumbSchema = {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": siteUrl
            }
        ]
    };
    if (pageType === 'article') {
        breadcrumbSchema.itemListElement.push({
            "@type": "ListItem",
            "position": 2,
            "name": data.categoryName || "Category",
            "item": `${siteUrl}/${data.categorySlug}`
        });
        breadcrumbSchema.itemListElement.push({
            "@type": "ListItem",
            "position": 3,
            "name": pageTitle,
            "item": currentUrl
        });
    } else {
        breadcrumbSchema.itemListElement.push({
            "@type": "ListItem",
            "position": 2,
            "name": pageType ? pageType.charAt(0).toUpperCase() + pageType.slice(1) : 'Page',
            "item": `${siteUrl}/${pageType || 'page'}`
        });
        breadcrumbSchema.itemListElement.push({
            "@type": "ListItem",
            "position": 3,
            "name": pageTitle,
            "item": currentUrl
        });
    }
}

if (schemaObj && breadcrumbSchema) {
    schemaString = JSON.stringify([schemaObj, breadcrumbSchema]);
} else if (breadcrumbSchema) {
    schemaString = JSON.stringify(breadcrumbSchema);
}

if (data.customSchema) {
    try {
        JSON.parse(data.customSchema);
        schemaString = data.customSchema.replace(/<\/script/gi, '<\\/script');
    } catch(e) {
        // Invalid JSON — skip injection
    }
}

const acceptHeader = Astro.request.headers.get('Accept') || '';
const wantsMarkdown = acceptHeader.includes('text/markdown') || acceptHeader.includes('application/json');
if (!showPasswordPrompt && wantsMarkdown && (pageType === 'article' || pageType === 'page')) {
    let mdContent = parsedContent;
    try {
        const TurndownService = (await import('turndown')).default;
        const turndownService = new TurndownService();
        mdContent = turndownService.turndown(parsedContent);
    } catch (e) {
        mdContent = parsedContent.replace(/<[^>]+>/g, '\n').replace(/\n\n+/g, '\n\n').trim();
    }

    // Match Obsidian Web Clipper conventions:
    //   created, tags, source, author frontmatter → # Title → > ## Excerpt → --- → body
    const now = new Date();
    const offsetMin = -now.getTimezoneOffset();
    const offsetSign = offsetMin >= 0 ? '+' : '-';
    const offsetH = String(Math.floor(Math.abs(offsetMin) / 60)).padStart(2, '0');
    const offsetM = String(Math.abs(offsetMin) % 60).padStart(2, '0');
    const isoWithOffset = `${now.toISOString().replace(/\.\d{3}Z$/, '')} (UTC ${offsetSign}${offsetH}:${offsetM})`;
    const sourceUrl = data.canonicalUrl
        ? (data.canonicalUrl.startsWith('http') ? data.canonicalUrl : `${siteUrl}${data.canonicalUrl}`)
        : `${siteUrl}/${data.slug}`;

    const excerpt = data.metaDescription || data.excerpt || '';

    const mdHeader = `---\ncreated: ${isoWithOffset}\ntags: []\nsource: ${sourceUrl}\nauthor: ${data.authorName || ''}\n---\n\n# ${pageTitle}\n\n`;
    const mdExcerpt = excerpt ? `> ## Excerpt\n> ${excerpt}\n\n---\n\n` : `---\n\n`;

    return new Response(mdHeader + mdExcerpt + mdContent.trim() + '\n', {
        status: 200,
        headers: {
            'Content-Type': 'text/markdown; charset=utf-8',
            'x-markdown-tokens': 'true'
        }
    });
}

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---
{isHomepageFallback ? <IndexPage /> : (
<LayoutArticlePage 
    title={pageTitle} 
    metaDescription={data.metaDescription} 
    schema={schemaString} 
    headerStyle={headerStyle} 
    footerStyle={footerStyle} 
    canonicalUrl={data.canonicalUrl ? data.canonicalUrl : `/${data.slug}`}
    ogImage={headerImage ? (headerImage.startsWith('http') ? headerImage : `${Astro.url.origin}${headerImage.startsWith('/') ? '' : '/'}${headerImage}`) : undefined}
    author={data.authorName || undefined}
    noindex={currentPage > 1 ? "noindex, follow" : (pageType === 'taxonomy_archive' ? (data.taxonomy?.umbrellaAllowIndexing === false || data.taxonomy?.umbrellaAllowIndexing === 0) : (data.taxonomy?.allowIndexing === false || data.taxonomy?.allowIndexing === 0))}
>
    {(pageType === 'category' || pageType === 'collection_archive') && (
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
            <div class={`grid grid-cols-1 gap-8 md:gap-12 ${showLeftSidebar && showRightSidebar ? 'lg:grid-cols-4' : (showLeftSidebar || showRightSidebar) ? 'lg:grid-cols-3' : 'lg:grid-cols-1'}`}>
                
                {showLeftSidebar && (
                    <aside class="lg:col-span-1 mt-12 lg:mt-0 order-last lg:order-first">
                        <GlobalSidebar zone="left" context="category" />
                    </aside>
                )}

                <div class={`${showLeftSidebar && showRightSidebar ? 'lg:col-span-2' : (showLeftSidebar || showRightSidebar) ? 'lg:col-span-2' : 'lg:col-span-1'}`}>
                    <div class="mb-12 border-b-4 border-primary pb-2 flex justify-between items-end">
                        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight uppercase text-foreground">
                            {pageType === 'collection_archive' ? data.title : t('category.title', 'Category: {name}').replace('{name}', data.name)} {currentPage > 1 ? `(${t('common.page', 'Page')} ${currentPage})` : ''}
                        </h1>
                        <ViewToggle />
                    </div>
                    
                    <div class="article-archive-layout mb-12">
                        {categoryArticles.map((article, index) => (
                            <>
                                {index > 0 && index % 4 === 0 && archiveInBetweenHtml && (
                                    <div class="col-span-full w-full my-4 flex justify-center" set:html={archiveInBetweenHtml} />
                                )}
                                <a href={article.canonicalUrl} class="article-archive-card group flex bg-muted/20 border border-border rounded-xl overflow-hidden hover:shadow-lg transition-all hover:-translate-y-1">
                                <div class="article-archive-card-img-wrapper relative overflow-hidden flex-shrink-0">
                                    <img 
                                        src={article.displayImage || article.featuredImageUrl || article.featuredImage || getThumbnail(article.displayContent || article.content)} 
                                        alt={article.displayTitle || article.title || article.slug} 
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                        loading="lazy" 
                                    />
                                </div>
                                <div class="p-4 flex flex-col flex-1 min-w-0">
                                    <div class="flex items-center space-x-2 text-[10px] uppercase font-bold tracking-wider mb-2 text-muted-foreground flex-wrap">
                                        <span class="truncate max-w-full">{article.authorName}</span>
                                        <span>&bull;</span>
                                        <time class="flex-shrink-0">{new Date(article.publishedAt).toLocaleDateString()}</time>
                                        <span class="hidden md:inline">&bull;</span>
                                        <span class="hidden md:inline text-primary truncate max-w-[120px]">{article.categoryName || data.name}</span>
                                    </div>
                                    <h3 class="text-base md:text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3 mb-2">
                                        {article.displayTitle || article.title || article.slug}
                                    </h3>
                                    <p class="text-xs text-muted-foreground line-clamp-2 mt-auto">
                                        {article.displayExcerpt || article.excerpt}
                                    </p>
                                </div>
                            </a>
                            </>
                        ))}
                    </div>

                    <Pagination 
                        currentPage={currentPage} 
                        totalPages={totalPages} 
                        baseUrl={data.canonicalUrl || `/${data.slug || slug}`} 
                    />
                </div>

                {showRightSidebar && (
                    <aside class="lg:col-span-1 mt-12 lg:mt-0">
                        <GlobalSidebar zone="right" context="category" />
                    </aside>
                )}
            </div>
        </div>
    )}

    {pageType === 'taxonomy_archive' && (
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
            <div class="mb-12 border-b-4 border-primary pb-2 text-center">
                <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight uppercase text-foreground">
                    {t('taxonomy.directory', 'Directory: {title}').replace('{title}', data.title)} {currentPage > 1 ? `(${t('common.page', 'Page')} ${currentPage})` : ''}
                </h1>
            </div>
            
            {data.taxonomy?.umbrellaViewMode === 'all_entries' ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {categoryArticles && categoryArticles.map((article: any) => (
                        <a href={article.canonicalUrl} class="group block border-2 border-border/50 rounded-2xl overflow-hidden hover:border-primary/50 hover:shadow-lg transition-all flex flex-col h-full bg-card">
                            {(article.displayImage || article.featuredImageUrl || article.featuredImage || getThumbnail(article.displayContent || article.content)) && (
                                <div class="aspect-video w-full overflow-hidden bg-muted">
                                    <img 
                                        src={article.displayImage || article.featuredImageUrl || article.featuredImage || getThumbnail(article.displayContent || article.content)} 
                                        alt={article.displayTitle || article.title || article.slug} 
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        loading="lazy"
                                    />
                                </div>
                            )}
                            <div class="p-6 flex flex-col flex-grow">
                                <div class="flex items-center space-x-2 text-[10px] uppercase font-bold tracking-wider mb-2 text-muted-foreground flex-wrap">
                                    <span class="truncate max-w-full">{article.authorName}</span>
                                    <span>&bull;</span>
                                    <time class="flex-shrink-0">{new Date(article.publishedAt).toLocaleDateString()}</time>
                                    <span class="hidden md:inline">&bull;</span>
                                    <span class="hidden md:inline text-primary truncate max-w-[120px]">{article.categoryName || data.title}</span>
                                </div>
                                <h3 class="text-base md:text-lg font-bold leading-snug group-hover:text-primary transition-colors line-clamp-3 mb-2">
                                    {article.displayTitle || article.title || article.slug}
                                </h3>
                                <p class="text-xs text-muted-foreground line-clamp-2 mt-auto">
                                    {article.displayExcerpt || article.excerpt}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            ) : (
                <div class="mt-8 flex flex-col sm:flex-row justify-between items-center border-b border-border pb-4 mb-6">
                    <h2 class="text-xl font-bold text-foreground">{t('taxonomy.all_tags', 'All Tags')}</h2>
                    <div class="mt-4 sm:mt-0 flex items-center gap-3">
                        <label for="sort-tags" class="text-sm text-muted-foreground font-medium">{t('taxonomy.sort_by', 'Sort By:')}</label>
                        <select 
                            id="sort-tags" 
                            class="bg-background border border-input text-foreground text-sm rounded-lg focus:ring-primary focus:border-primary block p-2"
                            onchange="window.location.search = '?sort=' + this.value"
                        >
                            <option value="popular" selected={Astro.url.searchParams.get('sort') !== 'az'}>{t('taxonomy.most_popular', 'Most Popular')}</option>
                            <option value="az" selected={Astro.url.searchParams.get('sort') === 'az'}>{t('taxonomy.a_z', 'A - Z')}</option>
                        </select>
                    </div>
                </div>
                
                <div class="flex flex-wrap gap-3">
                    {termsList && termsList.map((term: any) => (
                        <a href={`/${data.omitTaxonomySlug ? term.slug : `${data.taxonomySlug}/${term.slug}`}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-muted/40 border border-border/60 hover:border-primary/50 rounded-full text-foreground hover:bg-primary hover:text-primary-foreground font-medium shadow-sm hover:shadow transition-all text-sm md:text-base group">
                            <span>{term.name}</span>
                            {term.entryCount !== undefined && (
                                <span class="text-xs bg-background/50 group-hover:bg-primary-foreground/20 px-2 py-0.5 rounded-full text-muted-foreground group-hover:text-primary-foreground transition-colors">
                                    {term.entryCount}
                                </span>
                            )}
                        </a>
                    ))}
                </div>
            )}
            
            <div class="mt-12">
                <Pagination 
                    currentPage={currentPage} 
                    totalPages={totalPages} 
                    baseUrl={`/${data.taxonomySlug || slug}`} 
                />
            </div>
        </div>
    )}

    {pageType === 'page' && data.is_block_builder && (
        <main class="w-full">
            <BlockRenderer layoutBlocks={layoutBlocks} blockData={blockData} showLeftSidebar={showLeftSidebar} showRightSidebar={showRightSidebar} />
        </main>
    )}

    {pageType !== 'category' && pageType !== 'collection_archive' && pageType !== 'taxonomy_archive' && !(pageType === 'page' && data.is_block_builder) && pageType !== null && (
        showPasswordPrompt ? (
            <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <div class="bg-muted/10 border-2 border-border/50 p-8 rounded-2xl shadow-sm text-center max-w-md mx-auto my-12">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-primary"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <h3 class="text-2xl font-bold mb-2 uppercase tracking-wide">{t('article.protected_content', 'Protected Content')}</h3>
                    <p class="text-muted-foreground mb-6 text-sm">{t('article.password_prompt', 'This content is password protected. To view it please enter your password below:')}</p>
                    
                    {passwordError && <p class="text-destructive font-semibold mb-4 text-sm">{t('article.incorrect_password', 'Incorrect password.')}</p>}
                    
                    <form method="POST" class="flex flex-col gap-4">
                        <input type="password" name="post_password" placeholder={t('article.password_placeholder', 'Password')} required class="w-full h-12 rounded-lg border-2 border-border bg-background px-4 text-center focus-visible:outline-none focus-visible:border-primary transition-colors" />
                        <button type="submit" class="h-12 w-full bg-primary text-primary-foreground font-bold uppercase tracking-widest rounded-lg hover:bg-primary/90 transition-colors">{t('article.submit', 'Submit')}</button>
                    </form>
                </div>
            </div>
        ) : (
            <ModularTemplateRenderer 
                data={data}
                parsedContent={parsedContent}
                showLeftSidebar={showLeftSidebar}
                showRightSidebar={showRightSidebar}
                articleUpperHtml={articleUpperHtml}
                articleBottomHtml={articleBottomHtml}
                headerImage={headerImage}
            />
        )
    )}
</LayoutArticlePage>
)}
